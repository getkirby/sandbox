{
    "files.exclude": {
        "environments": true
    },
    "editor.formatOnSave": true,
    "intelephense.format.enable": false,
    "[php]": {
        "editor.defaultFormatter": "junstyle.php-cs-fixer"
    },
    "php-cs-fixer.executablePath": "${workspaceFolder}/.vscode/php-cs-fixer",
    "php-cs-fixer.config": "",
    "php-cs-fixer.rules": "",
    "[javascript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[vue]": {
        "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "oxc.path.oxfmt": "kirby/panel/node_modules/.bin/oxfmt",
    "eslint.workingDirectories": ["./kirby/panel"],
    "vitest.rootConfig": "kirby/panel/vite.config.js",
    "phpunit.command": "composer --working-dir=${workspaceFolder}/kirby test -- ${phpunitargs}",
    "phpunit.args": ["--configuration=${workspaceFolder}/kirby/phpunit.dist.xml"],
    "phpunit.environment": {
        "COMPOSER_PROCESS_TIMEOUT": "0"
    }
}
